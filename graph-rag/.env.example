NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
GRAPH_RAG_K=5

# Comma-separated list of git repositories to ingest into this ONE graph.
# Each entry is `name=path` (path resolved relative to this repo's root, i.e.
# the parent of this graph-rag/ folder, unless absolute) or just `path`, in
# which case the directory's basename becomes the project name.
#
# Single project (default — just the repo this kit was installed into):
PROJECT_PATHS=.
#
# Multiple microservices sharing one graph (edit paths to your local checkouts):
# PROJECT_PATHS=orders=.,payments=../payments-service,shared-lib=../shared-lib

# Name for the *system* PROJECT_PATHS above belongs to. Only needed if this
# Neo4j container is shared with other, unrelated systems (e.g. one Docker
# instance reused across several unrelated products, each with its own set
# of microservices) — set a different PROJECT_GROUP per system so their
# Projects/Topics/Databases never merge onto the same node just because they
# happen to reuse a common name (e.g. two unrelated systems both having a
# "gateway" service, or both using a Postgres database named "app_db").
# Projects *within* one group still relate to each other normally (that's
# the whole point of PROJECT_PATHS) — this only isolates *between* groups.
# Neo4j Community Edition has no native multi-database/multi-tenant support
# (that needs Enterprise), so this is a property-based partition of one
# shared database, not a hard database-level boundary — good enough to stop
# accidental cross-talk, not a security boundary.
PROJECT_GROUP=default
